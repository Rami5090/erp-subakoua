# Modèle de secrets Streamlit. Copiez ce fichier en `.streamlit/secrets.toml` (local)
# ou collez son contenu dans Streamlit Cloud → Settings → Secrets.
# NE JAMAIS committer le vrai secrets.toml.

[mysql]                     # utilisateur avec droits d'écriture (réservé au mode « utilisateur »)
host = ""
port = "3306"
user = ""
password = ""
database = ""

[mysql_readonly]            # OPTIONNEL mais recommandé : utilisateur MySQL avec uniquement SELECT
host = ""                   # utilisé pour les visiteurs et les pages de consultation
port = "3306"
user = ""
password = ""
database = ""

[auth]
# Mot de passe du mode « utilisateur » (accès complet). Sans mot de passe : tout le monde reste visiteur.
user_password = ""
# Alternative plus sûre (hash SHA-256 hexadécimal ; remplace le mot de passe en clair) :
#   python -c "import hashlib,getpass;print(hashlib.sha256(getpass.getpass().encode()).hexdigest())"
# user_password_sha256 = ""

[subakoua]
user = ""
password = ""
